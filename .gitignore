# Baseline .gitignore — bootstrap copies this to ./.gitignore at git init.
# Extend per project for its stack (see the env-setup rule). Lock file in
# .agents/generated/ IS committed (provenance) — do not ignore it — in a private
# repository. A public one also appends templates/gitignore-public (canon step 5).

# secrets — never commit (templates like .env.example are kept)
.env
.env.*
!.env.example
.dev.vars
.secrets
*.pem
id_rsa
id_ed25519

# dependencies
node_modules/
.venv/
venv/
__pycache__/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# build / generated artifacts
# built from cards.js by `npm run build`; package.json `files` ships it, git never does
cards.min.js
*.tgz
dist/
build/
.astro/
.wrangler/
*.log

# local indexes — regenerable caches (code-search / content-vault); never commit
.codegraph/
.docindex/

# heavy consumed inputs — context/ is committed, but bulky media is not
context/attachments/

# screenshots and the browser agent's scratch — two of them were swept into a
# commit in roulette-lite on 2026-09-21 by a careless `git add -A`
*.png
.playwright-mcp/

# OS junk
.DS_Store

# --- public repository: the product only; the agent's files stay on the maintainer's machine ---
# agent infrastructure — this is a public repository: it holds the product only. The agent's rules,
# plans, hooks, settings and memory stay on the maintainer's machine (canon BOOTSTRAP step 5).
.agents/
.claude/
.codex/
.opencode/
AGENTS.md
CLAUDE.md
opencode.json
.mcp.json
